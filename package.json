{
  "name": "nagarsetu-segue",
  "version": "3.2.0",
  "private": true,
  "description": "NAGARSETU Segue - AI-Powered Civic Issue Reporting Web Application (Full-Stack Unified)",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "node start-dev.js",
    "build": "npm run build --workspace=frontend",
    "vercel-build": "npm run build --workspace=frontend",
    "test": "npm test --workspace=backend",
    "start:backend": "npm start --workspace=backend",
    "start:frontend": "npm run dev --workspace=frontend",
    "start:ai": "cd ai_service && python main.py"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.4",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exifr": "^7.1.3",
    "express": "^4.19.2",
    "express-rate-limit": "^8.6.2",
    "form-data": "^4.0.6",
    "joi": "^18.2.5",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "pg": "^8.11.5",
    "sqlite3": "^6.0.1"
  }
}
